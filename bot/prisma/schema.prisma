generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth.js models ──────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Fortify models ──────────────────────────────────────
enum Tier {
  FREE
  PRO
  ELITE
  APEX
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  tier          Tier      @default(FREE)
  xp            Int       @default(0)
  streak        Int       @default(0)
  credits       Int       @default(0)
  leRaiseBatch  Boolean   @default(false) // owner-only: lift Lead Extractor per-batch account cap
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  subscription       Subscription?
  brandVoices        BrandVoice[]
  watchTerms         WatchTerm[]
  competitors        Competitor[]
  generations        Generation[]
  profile            Profile?
  notificationPrefs  NotificationPrefs?
  dealPosts          DealPost[]
  pods               PodMember[]
  creditTransactions CreditTransaction[]
}

model Announcement {
  id        String    @id @default(cuid())
  message   String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int      // positive = purchased, negative = spent
  source    String   // "purchase_800", "spend_hook", etc.
  orderId   String?  // PayPal order ID
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Profile {
  userId       String   @id
  niche        String?
  skills       String[]
  lookingFor   String[]
  canOffer     String[]
  socials      Json?
  reputation   Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String    @unique
  paypalSubId   String    @unique
  tier          Tier
  status        String    // ACTIVE, CANCELLED, SUSPENDED, EXPIRED
  startedAt     DateTime  @default(now())
  cancelledAt   DateTime?
  nextBillingAt     DateTime?
  paymentFailedAt   DateTime?
  paymentRescueStep Int       @default(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BrandVoice {
  id           String   @id @default(cuid())
  userId       String
  name         String
  trainingData String   @db.Text
  systemPrompt String   @db.Text
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchTerm {
  id        String   @id @default(cuid())
  userId    String
  term      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Competitor {
  id             String    @id @default(cuid())
  userId         String
  name           String
  url            String
  notes          String?   @db.Text
  lastReport     Json?
  lastScanned    DateTime?
  youtubeHandle  String?
  tiktokHandle   String?
  youtubeReport  Json?
  tiktokReport   Json?
  youtubeScanAt    DateTime?
  tiktokScanAt     DateTime?
  changeReport     Json?
  changeDetectedAt DateTime?
  reviewReport     Json?
  reviewScannedAt  DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NotificationPrefs {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Toggleable — all default true
  dmPaymentFailed   Boolean @default(true)
  dmWeeklyReport    Boolean @default(true)
  dmTrendAlerts     Boolean @default(true)
  dmCompetitorDone  Boolean @default(true)
  dmLimitWarning    Boolean @default(true)
  dmRenewalReminder Boolean @default(true)
  dmOnboarding      Boolean @default(true)
  dmMilestones      Boolean @default(true)
  dmMatchmaking     Boolean @default(true)
  dmOwnerNewSub     Boolean @default(true)
  dmOwnerChurn      Boolean @default(true)
}

model Generation {
  id        String   @id @default(cuid())
  userId    String
  type      String   // hook, caption, audit, voice, etc.
  input     String   @db.Text
  output    String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum DealType {
  HIRING
  COLLAB
  OPPORTUNITY
}

model DealPost {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @db.Text
  type        DealType
  budget      String?
  link        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Pod {
  id        String      @id @default(cuid())
  name      String
  createdAt DateTime    @default(now())
  members   PodMember[]
}

model PodMember {
  podId     String
  userId    String
  joinedAt  DateTime @default(now())
  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([podId, userId])
}
// ─── Drip DM campaigns (Discord) ─────────────────────────
enum DripCampaign {
  WELCOME     // fires on join, one person at a time
  ACTIVATION  // owner-triggered sweep over members without a plan
}

enum DripStatus {
  PENDING
  DONE
  STOPPED
}

// One row per person per campaign. The original design kept the whole queue as
// a single JSON blob because its store had no prefix scan; Postgres does, so the
// due-at index replaces that workaround and removes the single-writer limit.
model DripEnrollment {
  id        String       @id @default(cuid())
  discordId String
  campaign  DripCampaign
  stage     Int          @default(1)
  dueAt     DateTime
  status    DripStatus   @default(PENDING)
  sentCount Int          @default(0)
  lastError String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([discordId, campaign]) // re-running a rollout tops up, never restarts
  @@index([campaign, status, dueAt])
}

model DripCampaignState {
  campaign            DripCampaign @id
  paused              Boolean      @default(true)
  pausedReason        String?
  consecutiveFailures Int          @default(0)
  rolledOutAt         DateTime?
  updatedAt           DateTime     @updatedAt
}

// Permanent and keyed by Discord ID, so it survives re-seeding and applies to
// people who never created a Fortify account.
model DripOptOut {
  discordId String   @id
  source    String   @default("button")
  createdAt DateTime @default(now())
}

// Counters are period-keyed rather than reset in place, so a failed weekly
// report cannot destroy a week of data.
model DripMetric {
  periodStart DateTime
  key         String
  count       Int      @default(0)

  @@id([periodStart, key])
}

