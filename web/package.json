    "test:theme": "node --test scripts/test-site-theme.cjs",
    "test:workspace": "node --test scripts/test-workspace.cjs",
    "test:business": "node --test scripts/test-business-setup.cjs",
    "test:dashboard": "node --test scripts/test-dashboard-priority.cjs",
    "test:tutorial": "node --test scripts/test-workspace-tutorial.cjs",
