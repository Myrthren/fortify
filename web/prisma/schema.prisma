generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth.js models ──────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Fortify models ──────────────────────────────────────
enum Tier {
  FREE
  PRO
  ELITE
  APEX
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  discordId           String?   @unique
  avatarUrl           String?
  username            String?   @unique
  usernameChangesUsed Int       @default(0)
  showDiscordUsername Boolean   @default(false)
  allowMessages       Boolean   @default(true)
  allowConnections    Boolean   @default(true)
  softwareBanned      Boolean   @default(false)
  platformBanned      Boolean   @default(false)
  tier                Tier      @default(FREE)
  xp                  Int       @default(0)
  streak              Int       @default(0)
  credits             Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  subscription         Subscription?
  brandVoices          BrandVoice[]
  watchTerms           WatchTerm[]
  competitors          Competitor[]
  generations          Generation[]
  profile              Profile?
  notificationPrefs    NotificationPrefs?
  dealPosts            DealPost[]
  pods                 PodMember[]
  creditTransactions   CreditTransaction[]
  metaConnection       MetaConnection?
  googleConnection     GoogleConnection?
  shopifyConnection    ShopifyConnection?
  stripeConnection     StripeConnection?
  notionConnection     NotionConnection?
  socialConnections    SocialConnection[]
  mediaItems           MediaItem[]
  companyDna           CompanyDna?
  aiSessions           AiSession[]
  aiCreditPacks        AiCreditPack[]
  forumPosts           ForumPost[]
  forumComments        ForumComment[]
  sentMessages         UserMessage[]    @relation("SentMessages")
  receivedMessages     UserMessage[]    @relation("ReceivedMessages")
  sentConnections      UserConnection[] @relation("SentConnections")
  receivedConnections  UserConnection[] @relation("ReceivedConnections")
  bans                 BanRecord[]
  paypalConnections    PaypalConnection[]
}

model Announcement {
  id        String    @id @default(cuid())
  message   String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int      // positive = purchased, negative = spent
  source    String   // "purchase_800", "spend_hook", etc.
  orderId   String?  // PayPal order ID
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Profile {
  userId       String   @id
  niche        String?
  skills       String[]
  lookingFor   String[]
  canOffer     String[]
  socials      Json?
  reputation   Int      @default(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  paypalSubId       String    @unique
  tier              Tier
  status            String    // ACTIVE, CANCELLED, SUSPENDED, EXPIRED
  startedAt         DateTime  @default(now())
  cancelledAt       DateTime?
  nextBillingAt     DateTime?
  paymentFailedAt   DateTime?
  paymentRescueStep Int       @default(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BrandVoice {
  id           String   @id @default(cuid())
  userId       String
  name         String
  trainingData String   @db.Text
  systemPrompt String   @db.Text
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchTerm {
  id        String   @id @default(cuid())
  userId    String
  term      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Competitor {
  id               String    @id @default(cuid())
  userId           String
  name             String
  url              String
  notes            String?   @db.Text
  lastReport       Json?
  lastScanned      DateTime?
  youtubeHandle    String?
  tiktokHandle     String?
  youtubeReport    Json?
  tiktokReport     Json?
  youtubeScanAt    DateTime?
  tiktokScanAt     DateTime?
  changeReport     Json?
  changeDetectedAt DateTime?
  reviewReport     Json?
  reviewScannedAt  DateTime?
  metaAdReport      Json?
  metaAdScanAt      DateTime?
  instagramHandle   String?
  instagramReport   Json?
  instagramScanAt   DateTime?
  twitterHandle     String?
  twitterReport     Json?
  twitterScanAt     DateTime?
  serpReport        Json?
  serpScanAt        DateTime?
  createdAt         DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MetaConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  accessToken String   @db.Text
  accountId   String?  // primary ad account ID e.g. act_123456
  accountName String?
  connectedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopifyConnection {
  id                  String   @id @default(cuid())
  userId              String   @unique
  shop                String   // e.g. "mystore.myshopify.com"
  accessToken         String   @db.Text
  lastMilestoneAmount Float    @default(0) // last revenue milestone crossed (monthly), for dedup
  connectedAt         DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  apiKey      String   @db.Text
  lastMrr     Float    @default(0) // last recorded MRR for change detection
  connectedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleConnection {
  id              String   @id @default(cuid())
  userId          String   @unique
  accessToken     String   @db.Text
  refreshToken    String   @db.Text
  tokenExpiresAt  DateTime
  gaPropertyId    String?  // e.g. "properties/123456789"
  gaPropertyName  String?
  scSiteUrl       String?  // e.g. "https://example.com/"
  ytChannelId     String?
  ytChannelName   String?
  connectedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotionConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  accessToken String   @db.Text
  botId       String
  workspaceName String?
  workspaceIcon String?
  rootPageId  String?  // user-selected root export page
  connectedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialConnection {
  id           String    @id @default(cuid())
  userId       String
  platform     String    // "tiktok" | "youtube" | "facebook"
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  channelId    String?
  channelName  String?
  pageId       String?   // Facebook Page ID
  connectedAt  DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

enum PublishStatus {
  DRAFT
  ANALYZED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model MediaItem {
  id              String        @id @default(cuid())
  userId          String
  title           String
  description     String?       @db.Text
  videoUrl        String        @db.Text
  thumbnailUrl    String?
  category        String?
  targetPlatforms String[]
  viralityReport  Json?
  analyzedAt      DateTime?
  publishStatus   PublishStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  publishResults  Json?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([publishStatus, scheduledAt])
}

model NotificationPrefs {
  userId            String  @id
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Toggleable — all default true
  dmPaymentFailed   Boolean @default(true)
  dmWeeklyReport    Boolean @default(true)
  dmTrendAlerts     Boolean @default(true)
  dmCompetitorDone  Boolean @default(true)
  dmLimitWarning    Boolean @default(true)
  dmRenewalReminder Boolean @default(true)
  dmOnboarding      Boolean @default(true)
  dmMilestones      Boolean @default(true)
  dmMatchmaking     Boolean @default(true)
  dmOwnerNewSub          Boolean @default(true)
  dmOwnerChurn           Boolean @default(true)
  dmAdReport             Boolean @default(true)
  dmShopifyLowStock      Boolean @default(true)
  dmShopifyOutOfStock    Boolean @default(true)
  dmShopifyWeeklyRevenue Boolean @default(true)
  dmShopifyMilestone     Boolean @default(true)
  dmStripeMrrDrop        Boolean @default(true)
  dmContentBrief         Boolean @default(true)
}

// ─── Company DNA ─────────────────────────────────────────
model CompanyDna {
  id         String   @id @default(cuid())
  userId     String   @unique
  entries    Json     @default("[]") // {id,label,content,chars,createdAt}[]
  totalChars Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Fortify AI sessions ──────────────────────────────────
model AiSession {
  id          String   @id @default(cuid())
  userId      String
  startedAt   DateTime @default(now())
  expiresAt   DateTime // startedAt + 24h
  usedCostGbp Float    @default(0)
  budgetGbp   Float
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiCreditPack {
  id          String    @id @default(cuid())
  userId      String
  pack        Int       // 1 | 2 | 3
  budgetGbp   Float
  usedCostGbp Float     @default(0)
  purchasedAt DateTime  @default(now())
  exhaustedAt DateTime?
  orderId     String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Forums ───────────────────────────────────────────────
model Forum {
  id          String      @id @default(cuid())
  title       String
  description String?
  createdById String
  pinned      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  posts       ForumPost[]
}

model ForumPost {
  id        String         @id @default(cuid())
  forumId   String
  userId    String
  title     String
  body      String         @db.Text
  pinned    Boolean        @default(false)
  flagged   Boolean        @default(false)
  deleted   Boolean        @default(false)
  createdAt DateTime       @default(now())
  forum     Forum          @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  ForumComment[]

  @@index([forumId, createdAt])
}

model ForumComment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  body      String    @db.Text
  flagged   Boolean   @default(false)
  deleted   Boolean   @default(false)
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ─── User messaging ───────────────────────────────────────
model UserMessage {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  body       String   @db.Text
  read       Boolean  @default(false)
  flagged    Boolean  @default(false)
  createdAt  DateTime @default(now())
  from       User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, read])
  @@index([fromUserId])
}

// ─── Connections (LinkedIn-style) ────────────────────────
enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model UserConnection {
  id         String           @id @default(cuid())
  fromUserId String
  toUserId   String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  from       User             @relation("SentConnections", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User             @relation("ReceivedConnections", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
}

// ─── Ban records ──────────────────────────────────────────
enum BanType {
  PLATFORM
  SOFTWARE
}

model BanRecord {
  id          String    @id @default(cuid())
  userId      String
  type        BanType
  reason      String?
  permanent   Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  unbannedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── PayPal connection (for Revenue feature) ─────────────
model PaypalConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  merchantId  String
  clientId    String
  accessToken String   @db.Text
  expiresAt   DateTime
  connectedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Generation {
  id        String   @id @default(cuid())
  userId    String
  type      String   // hook, caption, audit, voice, etc.
  input     String   @db.Text
  output    String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum DealType {
  HIRING
  COLLAB
  OPPORTUNITY
}

model DealPost {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @db.Text
  type        DealType
  budget      String?
  link        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Pod {
  id        String      @id @default(cuid())
  name      String
  createdAt DateTime    @default(now())
  members   PodMember[]
}

model PodMember {
  podId     String
  userId    String
  joinedAt  DateTime @default(now())
  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([podId, userId])
}
