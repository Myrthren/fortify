generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth.js models ──────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Fortify models ──────────────────────────────────────
enum Tier {
  FREE
  PRO
  ELITE
  APEX
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  discordId           String?   @unique
  whopUserId          String?   @unique // Whop OAuth sub, e.g. "user_xxx"
  avatarUrl           String?
  username            String?   @unique
  usernameChangesUsed Int       @default(0)
  showDiscordUsername Boolean   @default(false)
  allowMessages       Boolean   @default(true)
  allowConnections    Boolean   @default(true)
  softwareBanned      Boolean   @default(false)
  platformBanned      Boolean   @default(false)
  tier                Tier      @default(FREE)
  xp                  Int       @default(0)
  streak              Int       @default(0)
  credits             Int       @default(100)
  creditsResetAt      DateTime? // tracks last monthly credit top-up
  freeAiUsed          Boolean   @default(false) // one-time £0.20 Fortify AI trial for FREE tier
  leRaiseBatch        Boolean   @default(false) // owner-only: lift Lead Extractor per-batch account cap
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  subscription          Subscription?
  brandVoices           BrandVoice[]
  watchTerms            WatchTerm[]
  competitors           Competitor[]
  generations           Generation[]
  profile               Profile?
  notificationPrefs     NotificationPrefs?
  dealPosts             DealPost[]
  pods                  PodMember[]
  creditTransactions    CreditTransaction[]
  metaConnection        MetaConnection?
  googleConnection      GoogleConnection?
  shopifyConnection     ShopifyConnection?
  stripeConnection      StripeConnection?
  notionConnection      NotionConnection?
  socialConnections     SocialConnection[]
  mediaItems            MediaItem[]
  companyDna            CompanyDna?
  aiSessions            AiSession[]
  aiCreditPacks         AiCreditPack[]
  forumPosts            ForumPost[]
  forumComments         ForumComment[]
  sentMessages          UserMessage[]          @relation("SentMessages")
  receivedMessages      UserMessage[]          @relation("ReceivedMessages")
  sentConnections       UserConnection[]       @relation("SentConnections")
  receivedConnections   UserConnection[]       @relation("ReceivedConnections")
  bans                  BanRecord[]
  paypalConnections     PaypalConnection[]
  chatSessions          ChatSession[]
  notifications         Notification[]
  reconSearches         ReconSearch[]
  leadStatuses          LeadStatus[]
  revenueEvents         RevenueEvent[]
  milestoneAwards       MilestoneAward[]
  matchNotifications    MatchNotification[]
  competitorWatches     CompetitorWatch[]
  workflows             Workflow[]
  workflowCapacityPacks WorkflowCapacityPack[]
  abuseAlerts           AbuseAlert[]
  outboundCampaigns     OutboundCampaign[]
  outboundLeads         OutboundLead[]
  outboundSuppressions  OutboundSuppression[]
}

model Announcement {
  id        String    @id @default(cuid())
  message   String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // positive = purchased, negative = spent
  source    String // "purchase_800", "spend_hook", etc.
  orderId   String? // PayPal order ID
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Profile {
  userId     String   @id
  niche      String?
  skills     String[]
  lookingFor String[]
  canOffer   String[]
  socials    Json?
  reputation Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  provider          String    @default("paypal") // "paypal" | "whop"
  paypalSubId       String?   @unique
  whopMembershipId  String?   @unique
  tier              Tier
  status            String // ACTIVE, CANCELLED, SUSPENDED, EXPIRED
  startedAt         DateTime  @default(now())
  cancelledAt       DateTime?
  nextBillingAt     DateTime?
  paymentFailedAt   DateTime?
  paymentRescueStep Int       @default(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Fortify's own subscription revenue (owner accounting) ───────────────────
model RevenueEvent {
  id         String   @id @default(cuid())
  userId     String?
  provider   String // "paypal" | "whop"
  externalId String   @unique // provider payment id — dedupes webhook retries
  amount     Float
  currency   String   @default("GBP")
  tier       Tier?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model BrandVoice {
  id           String   @id @default(cuid())
  userId       String
  name         String
  trainingData String   @db.Text
  systemPrompt String   @db.Text
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WatchTerm {
  id            String    @id @default(cuid())
  userId        String
  term          String
  createdAt     DateTime  @default(now())
  baselineCount Int? // rolling recent-coverage baseline, set on first scan
  lastAlertAt   DateTime? // throttles repeat spike alerts for the same term
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Milestone awards (dedupes dmMilestones DMs) ─────────────────────────────
model MilestoneAward {
  id        String   @id @default(cuid())
  userId    String
  key       String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// ─── Matchmaking DMs already sent (dedupes dmMatchmaking) ────────────────────
model MatchNotification {
  id        String   @id @default(cuid())
  userId    String
  matchedId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchedId])
}

model Competitor {
  id               String    @id @default(cuid())
  userId           String
  name             String
  url              String
  notes            String?   @db.Text
  lastReport       Json?
  lastScanned      DateTime?
  youtubeHandle    String?
  tiktokHandle     String?
  youtubeReport    Json?
  tiktokReport     Json?
  youtubeScanAt    DateTime?
  tiktokScanAt     DateTime?
  changeReport     Json?
  changeDetectedAt DateTime?
  reviewReport     Json?
  reviewScannedAt  DateTime?
  metaAdReport     Json?
  metaAdScanAt     DateTime?
  instagramHandle  String?
  instagramReport  Json?
  instagramScanAt  DateTime?
  twitterHandle    String?
  twitterReport    Json?
  twitterScanAt    DateTime?
  serpReport       Json?
  serpScanAt       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MetaConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  accessToken String   @db.Text
  accountId   String? // primary ad account ID e.g. act_123456
  accountName String?
  connectedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopifyConnection {
  id                  String   @id @default(cuid())
  userId              String   @unique
  shop                String // e.g. "mystore.myshopify.com"
  accessToken         String   @db.Text
  lastMilestoneAmount Float    @default(0) // last revenue milestone crossed (monthly), for dedup
  connectedAt         DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StripeConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  apiKey      String   @db.Text
  lastMrr     Float    @default(0) // last recorded MRR for change detection
  connectedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  accessToken    String   @db.Text
  refreshToken   String   @db.Text
  tokenExpiresAt DateTime
  gaPropertyId   String? // e.g. "properties/123456789"
  gaPropertyName String?
  scSiteUrl      String? // e.g. "https://example.com/"
  ytChannelId    String?
  ytChannelName  String?
  connectedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotionConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  accessToken   String   @db.Text
  botId         String
  workspaceName String?
  workspaceIcon String?
  rootPageId    String? // user-selected root export page
  connectedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialConnection {
  id           String    @id @default(cuid())
  userId       String
  platform     String // "tiktok" | "youtube" | "facebook"
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  channelId    String?
  channelName  String?
  pageId       String? // Facebook Page ID
  connectedAt  DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

enum PublishStatus {
  DRAFT
  ANALYZED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model MediaItem {
  id              String        @id @default(cuid())
  userId          String
  title           String
  description     String?       @db.Text
  videoUrl        String        @db.Text
  thumbnailUrl    String?
  category        String?
  targetPlatforms String[]
  viralityReport  Json?
  analyzedAt      DateTime?
  publishStatus   PublishStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  publishResults  Json?
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([publishStatus, scheduledAt])
}

model NotificationPrefs {
  userId                 String  @id
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Toggleable — all default true
  dmPaymentFailed        Boolean @default(true)
  dmWeeklyReport         Boolean @default(true)
  dmTrendAlerts          Boolean @default(true)
  dmCompetitorDone       Boolean @default(true)
  dmLimitWarning         Boolean @default(true)
  dmRenewalReminder      Boolean @default(true)
  dmOnboarding           Boolean @default(true)
  dmMilestones           Boolean @default(true)
  dmMatchmaking          Boolean @default(true)
  dmOwnerNewSub          Boolean @default(true)
  dmOwnerChurn           Boolean @default(true)
  dmAdReport             Boolean @default(true)
  dmShopifyLowStock      Boolean @default(true)
  dmShopifyOutOfStock    Boolean @default(true)
  dmShopifyWeeklyRevenue Boolean @default(true)
  dmShopifyMilestone     Boolean @default(true)
  dmStripeMrrDrop        Boolean @default(true)
  dmContentBrief         Boolean @default(true)
}

// ─── Company DNA ─────────────────────────────────────────
model CompanyDna {
  id         String   @id @default(cuid())
  userId     String   @unique
  entries    Json     @default("[]") // {id,label,content,chars,createdAt}[]
  totalChars Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Fortify AI sessions ──────────────────────────────────
model AiSession {
  id          String   @id @default(cuid())
  userId      String
  startedAt   DateTime @default(now())
  expiresAt   DateTime // startedAt + 24h
  usedCostGbp Float    @default(0)
  budgetGbp   Float
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AiCreditPack {
  id          String    @id @default(cuid())
  userId      String
  pack        Int // 1 | 2 | 3
  budgetGbp   Float
  usedCostGbp Float     @default(0)
  purchasedAt DateTime  @default(now())
  exhaustedAt DateTime?
  orderId     String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Forums ───────────────────────────────────────────────
model Forum {
  id          String      @id @default(cuid())
  title       String
  description String?
  createdById String
  pinned      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  posts       ForumPost[]
}

model ForumPost {
  id        String         @id @default(cuid())
  forumId   String
  userId    String
  title     String
  body      String         @db.Text
  pinned    Boolean        @default(false)
  flagged   Boolean        @default(false)
  deleted   Boolean        @default(false)
  createdAt DateTime       @default(now())
  forum     Forum          @relation(fields: [forumId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  ForumComment[]

  @@index([forumId, createdAt])
}

model ForumComment {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  body      String    @db.Text
  flagged   Boolean   @default(false)
  deleted   Boolean   @default(false)
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ─── User messaging ───────────────────────────────────────
model UserMessage {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  body       String   @db.Text
  read       Boolean  @default(false)
  flagged    Boolean  @default(false)
  createdAt  DateTime @default(now())
  from       User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, read])
  @@index([fromUserId])
}

// ─── Connections (LinkedIn-style) ────────────────────────
enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model UserConnection {
  id         String           @id @default(cuid())
  fromUserId String
  toUserId   String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  from       User             @relation("SentConnections", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User             @relation("ReceivedConnections", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
}

// ─── Ban records ──────────────────────────────────────────
enum BanType {
  PLATFORM
  SOFTWARE
}

model BanRecord {
  id         String    @id @default(cuid())
  userId     String
  type       BanType
  reason     String?
  permanent  Boolean   @default(false)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  unbannedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── PayPal connection (for Revenue feature) ─────────────
model PaypalConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  merchantId  String
  clientId    String
  accessToken String   @db.Text
  expiresAt   DateTime
  connectedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Generation {
  id        String   @id @default(cuid())
  userId    String
  type      String // hook, caption, audit, voice, etc.
  input     String   @db.Text
  output    String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Fortify Recon ────────────────────────────────────
model ReconSearch {
  id         String   @id @default(cuid())
  userId     String
  location   String
  category   String?
  filters    Json?
  leads      Json     @default("[]")
  totalLeads Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Recon lead status (persists across searches, keyed by business URL) ──────
model LeadStatus {
  id        String   @id @default(cuid())
  userId    String
  url       String
  status    String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@index([userId])
}

// ─── Competitor Watch (change tracking) ──────────────
model CompetitorWatch {
  id          String                @id @default(cuid())
  userId      String
  name        String
  links       Json                  @default("[]") // [{id,url,label,type,lastHash?,lastScanAt?}]
  creditsPaid Int                   @default(0)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans       CompetitorWatchScan[]

  @@index([userId])
}

model CompetitorWatchScan {
  id        String          @id @default(cuid())
  watchId   String
  url       String
  summary   String?         @db.Text
  hasChange Boolean         @default(false)
  scannedAt DateTime        @default(now())
  watch     CompetitorWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId, scannedAt])
}

// ─── Automation Workflows ─────────────────────────────
model Workflow {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  nodes       Json          @default("[]") // WorkflowNode[]
  active      Boolean       @default(false)
  dailyUsage  Int           @default(0)
  lastUsageAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]

  @@index([userId])
}

model WorkflowRun {
  id           String    @id @default(cuid())
  workflowId   String
  status       String    @default("running") // "running"|"completed"|"failed"
  usedCapacity Int       @default(0)
  log          Json      @default("[]") // {nodeId, type, status, output, timestamp}[]
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, startedAt])
}

enum DealType {
  HIRING
  COLLAB
  OPPORTUNITY
}

model DealPost {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @db.Text
  type        DealType
  budget      String?
  link        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Pod {
  id        String      @id @default(cuid())
  name      String
  createdAt DateTime    @default(now())
  members   PodMember[]
}

model PodMember {
  podId    String
  userId   String
  joinedAt DateTime @default(now())
  pod      Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([podId, userId])
}

// ─── Chat sessions (Fortify AI history) ─────────────────
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String
  messages  Json // {role, content, actions?}[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Workflow capacity packs ──────────────────────────────
model WorkflowCapacityPack {
  id          String   @id @default(cuid())
  userId      String
  units       Int // 5000 or 12000
  pricePounds Float
  orderId     String?  @unique
  purchasedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Abuse / usage alerts ────────────────────────────────
model AbuseAlert {
  id          String   @id @default(cuid())
  userId      String
  feature     String // "ai_chat" | "outreach" | "recon" | "credits" | etc.
  description String   @db.Text
  alertCount  Int      @default(1)
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([dismissed, createdAt])
}

// ─── In-app notifications ─────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "connection_request" | "connection_accepted" | "new_message" | "system"
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── Outbound (autonomous AI cold email) ──────────────────
// A lead moves through OutboundStage in one direction. Every stage transition
// is driven by the engine tick, never by a user action, so the whole pipeline
// is resumable: a crash mid-stage leaves the lead on its previous stage and the
// next tick picks it up again.
enum OutboundStage {
  DISCOVERED // sourced, nothing fetched yet
  SCRAPED // website content captured
  ANALYSED // AI analysis + opportunities stored
  DRAFTED // first email written, awaiting approval or queue
  QUEUED // approved, waiting for its send slot
  SENT // at least one email delivered to the provider
  REPLIED // human replied
  BOUNCED // hard bounce
  UNSUBSCRIBED // opted out
  DISQUALIFIED // engine or human ruled it out (no email, no fit, blocklist)
}

enum OutboundCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OutboundEmailStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  DELIVERED
  OPENED
  REPLIED
  BOUNCED
  FAILED
  SKIPPED
}

enum OutboundReplySentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  AUTO_REPLY
  UNSUBSCRIBE
}

model OutboundCampaign {
  id     String                 @id @default(cuid())
  userId String
  name   String
  status OutboundCampaignStatus @default(DRAFT)

  // Who we are looking for. Consumed by the discovery provider.
  targetQuery String? // free text, e.g. "dental practices in Manchester"
  industry    String?
  location    String?

  // What we are selling. Fed into analysis + composition.
  offer        String? @db.Text
  senderName   String?
  senderEmail  String?
  senderTitle  String?
  brandVoiceId String?

  // Behaviour
  discoveryProvider    String  @default("google-maps") // registry key
  sendProvider         String  @default("smtp") // registry key
  dailySendCap         Int     @default(30)
  minHoursBetweenSends Int     @default(0) // 0 = spread evenly across the window
  sendWindowStartUtc   Int     @default(8) // hour of day, UTC
  sendWindowEndUtc     Int     @default(17)
  sendOnWeekends       Boolean @default(false)
  autoSend             Boolean @default(false) // false = drafts wait for approval
  followUpDelaysDays   Json    @default("[3,7,14]") // one entry per follow-up step
  maxFollowUps         Int     @default(3)
  minOpportunityScore  Int     @default(40) // below this, the lead is disqualified

  // How many live leads to keep sourced. Discovery tops up towards this.
  leadTarget Int @default(100)

  // In-flight two-phase discovery run (see DiscoveryProvider). Held on the
  // campaign so a timed-out tick loses nothing — the next tick collects it.
  discoveryJobId        String?
  discoveryJobStartedAt DateTime?
  lastDiscoveryAt       DateTime?
  lastTickAt            DateTime?
  lastError             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads  OutboundLead[]
  emails OutboundEmail[]

  @@index([userId, status])
}

model OutboundLead {
  id         String        @id @default(cuid())
  userId     String
  campaignId String
  stage      OutboundStage @default(DISCOVERED)

  // Identity
  company     String
  website     String?
  domain      String? // normalised, used for dedupe
  contactName String?
  email       String?
  phone       String?
  industry    String?
  location    String?
  source      String? // which discovery provider produced it

  // Scrape output
  scrapedText  String?   @db.Text
  scrapedPages Json? // [{url,title,chars}]
  scrapedAt    DateTime?

  // Analysis output — see lib/outbound/types.ts LeadAnalysis
  analysis         Json?
  opportunities    Json? // [{title,evidence,impact,fortifyService,score}]
  opportunityScore Int?
  summary          String?   @db.Text
  suggestedService String?
  analysedAt       DateTime?

  // Progress
  emailsSent     Int                     @default(0)
  followUpStep   Int                     @default(0)
  lastSentAt     DateTime?
  nextActionAt   DateTime? // when the engine should next touch this lead
  repliedAt      DateTime?
  replySentiment OutboundReplySentiment?
  meetingBooked  Boolean                 @default(false)

  notes              String? @db.Text
  disqualifiedReason String?
  lastError          String?
  errorCount         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign OutboundCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emails   OutboundEmail[]
  events   OutboundEvent[]

  // Dedupe is per-user, not per-campaign: emailing the same business from two
  // campaigns is the failure mode this is here to prevent.
  @@unique([userId, domain])
  @@index([campaignId, stage])
  @@index([stage, nextActionAt])
  @@index([userId, createdAt])
}

model OutboundEmail {
  id         String              @id @default(cuid())
  leadId     String
  campaignId String
  step       Int                 @default(0) // 0 = first touch, 1+ = follow-ups
  status     OutboundEmailStatus @default(DRAFT)

  subject String
  body    String @db.Text

  // Which variation dice were rolled — lets the UI show why two emails differ
  // and lets a future optimiser learn which combinations perform.
  variation Json?
  model     String?
  wordCount Int?

  providerId String? @unique // message id from the send provider
  messageId  String? @unique // RFC Message-ID, used to thread replies
  fromEmail  String?
  toEmail    String?

  scheduledAt DateTime?
  sentAt      DateTime?
  openedAt    DateTime?
  repliedAt   DateTime?
  bouncedAt   DateTime?
  failReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead     OutboundLead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign OutboundCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([status, scheduledAt])
  @@index([leadId, step])
}

model OutboundEvent {
  id        String   @id @default(cuid())
  leadId    String
  emailId   String?
  type      String // "discovered" | "scraped" | "analysed" | "drafted" | "sent" | "opened" | "replied" | "bounced" | "disqualified" | "error"
  detail    String?  @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  lead OutboundLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// Resume point for reading replies out of the sending mailbox.
//
// Tracking a UID rather than flagging messages as read is deliberate: this is
// the owner's real inbox, and a background job must not change what looks unread
// in it. UIDs only mean anything within one uidValidity generation, so that is
// stored alongside and a change resets the cursor.
model OutboundInbox {
  id          String    @id @default(cuid())
  host        String
  username    String
  mailbox     String    @default("INBOX")
  uidValidity String?
  lastUid     Int       @default(0)
  lastPolledAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([host, username, mailbox])
}

// Global per-user do-not-contact list. Survives lead deletion, which is the
// whole point — an unsubscribe must outlive the record that caused it.
model OutboundSuppression {
  id        String   @id @default(cuid())
  userId    String
  value     String // lowercased email or domain
  kind      String // "email" | "domain"
  reason    String? // "unsubscribed" | "bounced" | "manual" | "blocklist"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, value])
  @@index([userId, kind])
}

// ─── Drip DM campaigns (Discord) ─────────────────────────
enum DripCampaign {
  WELCOME     // fires on join, one person at a time
  ACTIVATION  // owner-triggered sweep over members without a plan
}

enum DripStatus {
  PENDING
  DONE
  STOPPED
}

// One row per person per campaign. The original design kept the whole queue as
// a single JSON blob because its store had no prefix scan; Postgres does, so the
// due-at index replaces that workaround and removes the single-writer limit.
model DripEnrollment {
  id        String       @id @default(cuid())
  discordId String
  campaign  DripCampaign
  stage     Int          @default(1)
  dueAt     DateTime
  status    DripStatus   @default(PENDING)
  sentCount Int          @default(0)
  lastError String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([discordId, campaign]) // re-running a rollout tops up, never restarts
  @@index([campaign, status, dueAt])
}

model DripCampaignState {
  campaign            DripCampaign @id
  paused              Boolean      @default(true)
  pausedReason        String?
  consecutiveFailures Int          @default(0)
  rolledOutAt         DateTime?
  updatedAt           DateTime     @updatedAt
}

// Permanent and keyed by Discord ID, so it survives re-seeding and applies to
// people who never created a Fortify account.
model DripOptOut {
  discordId String   @id
  source    String   @default("button")
  createdAt DateTime @default(now())
}

// Counters are period-keyed rather than reset in place, so a failed weekly
// report cannot destroy a week of data.
model DripMetric {
  periodStart DateTime
  key         String
  count       Int      @default(0)

  @@id([periodStart, key])
}
