# ─── Outbound Engine ──────────────────────────────
# Provider defaults. A campaign can override discovery/send per row; these are
# the fallbacks, and the registry drops to any available provider if unset.
OUTBOUND_DISCOVERY_PROVIDER=google-maps   # google-maps (needs APIFY_API_TOKEN) | brave
OUTBOUND_SCRAPE_PROVIDER=fetch
OUTBOUND_ANALYSIS_PROVIDER=claude
OUTBOUND_COMPOSE_PROVIDER=claude
OUTBOUND_SEND_PROVIDER=smtp               # smtp | resend
# smtp is the default on purpose: it sends from a real mailbox, so cold outreach
# complaints cannot damage the reputation of the sender that carries Fortify's
# own transactional mail. The cost is no open tracking and no bounce webhook.
OUTBOUND_FROM_EMAIL=                      # fallback sender when a campaign has none
OUTBOUND_TICK_BUDGET_MS=20000             # wall-clock budget per engine tick

# Resend delivery events (opens, bounces, complaints, replies).
# Resend dashboard → Webhooks → point at /api/outbound/webhook/resend.
# Without this the handler 503s in production rather than trusting unsigned events.
OUTBOUND_RESEND_WEBHOOK_SECRET=

# SMTP sender — falls back to the SMTP_* vars marketing/cold-outreach.js uses.
OUTBOUND_SMTP_HOST=smtp.ionos.co.uk
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_USER=
OUTBOUND_SMTP_PASS=
